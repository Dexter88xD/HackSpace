# Plain HTTP (host port 8080) redirects to HTTPS on host port 8443
http://{$CADDY_HOST} {
	redir https://{host}:8443{uri} permanent
}

{$CADDY_HOST} {
	tls internal

	@backend path /api/*

	handle @backend {
		reverse_proxy {$BACKEND_HOST}
	}

	handle {
		reverse_proxy {$FRONTEND_HOST}
	}
}

{$MINIO_API_DOMAIN} {
	tls internal
	reverse_proxy {$MINIO_API_HOST}
}

{$MINIO_CONSOLE_DOMAIN} {
	tls internal
	reverse_proxy {$MINIO_CONSOLE_HOST}
}
