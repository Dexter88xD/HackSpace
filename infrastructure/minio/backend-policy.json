{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::default",
        "arn:aws:s3:::avatar",
        "arn:aws:s3:::submission",
        "arn:aws:s3:::hackathon"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::default/*",
        "arn:aws:s3:::avatar/*",
        "arn:aws:s3:::submission/*",
        "arn:aws:s3:::hackathon/*"
      ]
    }
  ]
}
