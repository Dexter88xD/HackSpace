# Public URLs — Caddy serves HTTPS on host port 8443
# (42 cluster machines cannot bind ports below 1024)
CADDY_HOST=localhost
FRONTEND_URL=https://localhost:8443
CORS_ORIGIN=https://localhost:8443
# Exposed to browser code (VITE_ prefix): chat socket server
VITE_SOCKET_URL=https://localhost:8443

# Database
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/oauth/google/callback

# 42 Intra OAuth
INTRA42_CLIENT_ID=
INTRA42_CLIENT_SECRET=
INTRA42_CALLBACK_URL=https://localhost:8443/api/auth/oauth/42/callback

# Email (SMTP, used for email verification)
MAIL_USER=
MAIL_PASS=

# File storage (MinIO): root credentials are used only for server administration/provisioning.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Backend identity: distinct from root; generate a secret with openssl rand -hex 32.
MINIO_ACCESS_KEY=hackspace-backend
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=https://minio.localhost:8443
MINIO_API_DOMAIN=minio.localhost
MINIO_CONSOLE_DOMAIN=console.minio.localhost
# Maximum upload size in bytes (10 MiB)
MAX_FILE_UPLOAD_BYTES=10485760

# Development seed — never enable in production
NODE_ENV=development
SEED_DEV_DATA=false
SEED_EXPECTED_DB=transcendence
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
