# Database — Docker Compose network
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend configuration (VITE_ variables are exposed to browser-side code)
VITE_API_BASE_URL=https://localhost

# Backend configuration
FRONTEND_URL=https://localhost
CORS_ORIGIN=https://localhost

# Local service ports (some Compose mappings are currently hardcoded)
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_DIRECT_PORT=5174

# MinIO — username at least 3 characters, password at least 8 characters
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Maximum file upload size in bytes (10 MiB)
MAX_FILE_UPLOAD_BYTES=10485760
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Email (SMTP; configure for email verification)
MAIL_USER=
MAIL_PASS=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost/api/auth/oauth/google/callback

# 42 Intra OAuth
INTRA42_CLIENT_ID=
INTRA42_CLIENT_SECRET=
INTRA42_CALLBACK_URL=https://localhost/api/auth/oauth/42/callback

# Development database seed — never enable in production
NODE_ENV=development
SEED_DEV_DATA=false
SEED_EXPECTED_DB=transcendence
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Caddy reverse proxy configuration
CADDY_HOST=localhost
BACKEND_HOST=backend:3000
FRONTEND_HOST=frontend:5173