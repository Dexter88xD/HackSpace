# Database — Docker Compose network
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local service ports
BACKEND_PORT=3000
AI_PORT=8000
FRONTEND_PORT=5173
FRONTEND_DIRECT_PORT=5174

# Kafka
KAFKA_PORT=9092
KAFKA_BROKER=broker:9092

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

# 42 Intra OAuth
INTRA42_CLIENT_ID=
INTRA42_CLIENT_SECRET=
INTRA42_CALLBACK_URL=http://localhost:3000/auth/oauth/42/callback

# Development database seed — never enable in production
SEED_DEV_DATA=false
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
