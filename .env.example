# Database — Docker Compose network
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend configuration (VITE_ variables are exposed to browser-side code)
VITE_API_BASE_URL=http://localhost:3000

# Backend callback redirect URL
FRONTEND_URL=http://localhost:5173

# Local service ports (some Compose mappings are currently hardcoded)
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_DIRECT_PORT=5174

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Email (SMTP; configure for email verification)
MAIL_USER=
MAIL_PASS=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

# 42 Intra OAuth
INTRA42_CLIENT_ID=
INTRA42_CLIENT_SECRET=
INTRA42_CALLBACK_URL=http://localhost:3000/auth/oauth/42/callback

# Development database seed — never enable in production
NODE_ENV=development
SEED_DEV_DATA=false
SEED_EXPECTED_DB=transcendence
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
